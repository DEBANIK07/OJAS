# Copy this file to .env for local development (.env is already in .gitignore).
# On Render/Railway, set these in the dashboard instead. Never commit real keys.

# development | production
APP_ENV=development

# Server (the hosting platform normally sets PORT for you)
HOST=0.0.0.0
PORT=8000

# Comma-separated list. Leave empty in production: the backend serves the frontend itself (same origin).
# In development the defaults already allow localhost:8000 and Live Server (localhost:5501).
CORS_ORIGINS=

# Secrets
GEOAPIFY_API_KEY=
DATABASE_URL=

# Default location when a request omits coordinates (Kolkata)
DEFAULT_LAT=22.5726
DEFAULT_LNG=88.3639
DEFAULT_ELEVATION_M=15

# Engineering and finance assumptions (all optional; defaults live in config.py)
PERFORMANCE_RATIO=0.75
FALLBACK_GHI_KWH_M2_DAY=5.14
ELECTRICITY_TARIFF_INR_KWH=7.0
COST_PER_KW_INR=48000
GRID_CO2_FACTOR_KG_KWH=0.82